material {
    name : VrmUnlit,
    shadingModel : unlit,
    blending : masked,
    maskThreshold : 0.5,
    doubleSided : true,
    parameters : [
        { type : float4, name : baseColorFactor },
        { type : sampler2d, name : mainTexture },
        { type : bool, name : flipV }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        
        // Get UV coordinates
        vec2 uv = getUV0();
        
        // Flip V coordinate if needed (common issue with glTF textures)
        if (materialParams.flipV) {
            uv.y = 1.0 - uv.y;
        }
        
        // Sample texture and multiply by baseColorFactor
        vec4 texColor = texture(materialParams_mainTexture, uv);
        material.baseColor = texColor * materialParams.baseColorFactor;
        
        // Keep original alpha for masking (don't force to 1.0)
        // Alpha below maskThreshold will be discarded
    }
}
