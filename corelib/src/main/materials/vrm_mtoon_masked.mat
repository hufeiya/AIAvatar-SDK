material {
    name : VrmMToonMasked,
    shadingModel : lit,
    customSurfaceShading : true,
    blending : masked,
    maskThreshold : 0.5,
    doubleSided : true,
    parameters : [
        { type : float4, name : baseColorFactor },
        { type : sampler2d, name : mainTexture },
        { type : float3, name : shadeColorFactor },
        { type : sampler2d, name : shadeMultiplyTexture },
        { type : bool, name : hasShadeMultiplyTexture },
        { type : float, name : shadingShiftFactor },
        { type : sampler2d, name : shadingShiftTexture },
        { type : bool, name : hasShadingShiftTexture },
        { type : float, name : shadingShiftTextureScale },
        { type : float, name : shadingToonyFactor },
        { type : float3, name : parametricRimColorFactor },
        { type : sampler2d, name : rimMultiplyTexture },
        { type : bool, name : hasRimMultiplyTexture },
        { type : float, name : rimLightingMixFactor },
        { type : float, name : parametricRimFresnelPowerFactor },
        { type : float, name : parametricRimLiftFactor },
        { type : float3, name : matcapFactor },
        { type : sampler2d, name : matcapTexture },
        { type : bool, name : hasMatcapTexture },
        { type : float3, name : emissiveFactor },
        { type : sampler2d, name : emissiveTexture },
        { type : bool, name : hasEmissiveTexture },
        { type : bool, name : v0CompatShade },
        { type : bool, name : flipV },
        { type : float, name : lightIntensityScale },
        { type : float3, name : lightIrradianceSum }
    ],
    requires : [
        uv0
    ]
}

// MToon shading ported from pixiv/three-vrm (packages/three-vrm-materials-mtoon, mtoon.frag).
//
// Mapping notes vs three-vrm:
//  - Direct lights: surfaceShading() is invoked once per light, which mirrors three-vrm's
//    RE_Direct_MToon() being run per light in three.js.
//  - Rim + matcap: three-vrm accumulates unshadowed light irradiance into directSpecular and adds
//    rim ONCE after the light loop. Filament has no post-light hook in surface materials, so rim
//    lives in material.emissive (Filament adds emissive after all lights) and the accumulated
//    irradiance is provided by the app via the lightIrradianceSum uniform.
//  - Indirect light: material.specularFactor = 0 disables the IBL specular lobe, leaving
//    IBL diffuse = diffuseColor * irradiance, i.e. three-vrm's
//    RE_IndirectDiffuse_MToon: irradiance * BRDF_Lambert(diffuseColor).
//  - Filament directional light intensity is in lux while three-vrm expects intensities around 1.0;
//    lightIntensityScale converts (app sets it to 1 / referenceLux).
fragment {
    vec2 getMToonUV() {
        vec2 uv = getUV0();
        if (materialParams.flipV) {
            uv.y = 1.0 - uv.y;
        }
        return uv;
    }

    float linearstep(float a, float b, float t) {
        return clamp((t - a) / (b - a + 1e-5), 0.0, 1.0);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getMToonUV();
        material.baseColor = texture(materialParams_mainTexture, uv) * materialParams.baseColorFactor;
        material.roughness = 1.0;
        material.metallic = 0.0;
        material.specularFactor = 0.0;
        material.ambientOcclusion = 1.0;

        // -- MToon: rim lighting + matcap (three-vrm applies these once, after lighting) --
        vec3 normal = getWorldNormalVector();
        vec3 viewDir = getWorldViewVector();

        vec3 rim = materialParams.parametricRimColorFactor *
            pow(saturate(1.0 - dot(viewDir, normal) + materialParams.parametricRimLiftFactor),
                max(materialParams.parametricRimFresnelPowerFactor, 1e-4));

        if (materialParams.hasMatcapTexture) {
            mat3 viewFromWorld = mat3(getViewFromWorldMatrix());
            vec3 viewDirView = viewFromWorld * viewDir;
            vec3 normalView = viewFromWorld * normal;
            vec3 x = normalize(vec3(viewDirView.z, 0.0, -viewDirView.x));
            vec3 y = cross(viewDirView, x);
            vec2 sphereUv = 0.5 + 0.5 * vec2(dot(x, normalView), -dot(y, normalView));
            rim += materialParams.matcapFactor * texture(materialParams_matcapTexture, sphereUv).rgb;
        }

        if (materialParams.hasRimMultiplyTexture) {
            rim *= texture(materialParams_rimMultiplyTexture, uv).rgb;
        }

        // rimLightingMixFactor blends rim between white and the accumulated light irradiance
        vec3 rimMix = mix(vec3(1.0), materialParams.lightIrradianceSum,
            materialParams.rimLightingMixFactor);

        // -- MToon: emission --
        vec3 emissive = materialParams.emissiveFactor;
        if (materialParams.hasEmissiveTexture) {
            emissive *= texture(materialParams_emissiveTexture, uv).rgb;
        }

        material.emissive = vec4(emissive + rimMix * rim, 0.0);
    }

    // three-vrm getShading(): convert dotNL into a toon ramp using shadingShift/shadingToony,
    // then multiply by shadows.
    float getShading(float dotNL, float shadow, float shadingShift) {
        float shading = linearstep(
            -1.0 + materialParams.shadingToonyFactor,
            1.0 - materialParams.shadingToonyFactor,
            dotNL + shadingShift);
        return shading * shadow;
    }

    vec3 surfaceShading(
        const MaterialInputs materialInputs,
        const ShadingData shadingData,
        const LightData lightData
    ) {
        vec2 uv = getMToonUV();
        vec3 normal = getWorldNormalVector();
        float dotNL = clamp(dot(normal, lightData.l), -1.0, 1.0);

        float shadingShift = materialParams.shadingShiftFactor;
        if (materialParams.hasShadingShiftTexture) {
            shadingShift += texture(materialParams_shadingShiftTexture, uv).r
                * materialParams.shadingShiftTextureScale;
        }

        // visibility = shadow map (directional) / contact shadows; attenuation = distance falloff
        // (punctual only, matches three-vrm where attenuation is folded into the light color)
        float shadow = lightData.visibility;
        float shading = getShading(dotNL, shadow, shadingShift);

        vec3 shadeColor = materialParams.shadeColorFactor;
        if (materialParams.hasShadeMultiplyTexture) {
            shadeColor *= texture(materialParams_shadeMultiplyTexture, uv).rgb;
        }

        vec3 lightColor = lightData.colorIntensity.rgb
            * (lightData.colorIntensity.w * materialParams.lightIntensityScale)
            * lightData.attenuation;

        // getDiffuse(): lightColor * BRDF_Lambert(mix(shade, lit, shading))
        vec3 col = lightColor * mix(shadeColor, shadingData.diffuseColor, shading) / PI;

        // V0_COMPAT_SHADE: clamp to the lit color after light multiplication (three-vrm behavior)
        if (materialParams.v0CompatShade) {
            col = min(col, shadingData.diffuseColor);
        }

        return col;
    }
}
