material {
    name : VrmMToonMasked,
    shadingModel : lit,
    customSurfaceShading : true,
    blending : masked,
    maskThreshold : 0.5,
    doubleSided : true,
    parameters : [
        { type : float4, name : baseColor },
        { type : float4, name : shadeColor },
        { type : float,  name : shadingToony },
        { type : float,  name : shadingShift },
        { type : float3, name : rimColor },
        { type : float,  name : rimPower },
        { type : float,  name : rimLift },
        { type : float,  name : rimLightingMix },
        { type : float3, name : emissiveColor },
        { type : float,  name : giEqualization },
        { type : sampler2d, name : mainTexture },
        { type : sampler2d, name : shadeTexture },
        { type : sampler2d, name : emissiveTexture },
        { type : bool, name : flipV },
        { type : bool, name : hasShadeTexture },
        { type : bool, name : hasEmissiveTexture },
        { type : bool, name : v0CompatShade }
    ],
    requires : [
        uv0
    ]
}

fragment {
    vec2 getFlippedUV() {
        vec2 uv = getUV0();
        if (materialParams.flipV) {
            uv.y = 1.0 - uv.y;
        }
        return uv;
    }
    
    float linearstep(float a, float b, float t) {
        return clamp((t - a) / (b - a + 0.00001), 0.0, 1.0);
    }
    
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        
        vec2 uv = getFlippedUV();
        vec4 texColor = texture(materialParams_mainTexture, uv);
        
        material.baseColor = texColor * materialParams.baseColor;
        
        material.roughness = 1.0;
        material.metallic = 0.0;
        
        vec3 emissive = materialParams.emissiveColor;
        if (materialParams.hasEmissiveTexture) {
            emissive *= texture(materialParams_emissiveTexture, uv).rgb;
        }
        material.emissive = vec4(emissive, 0.0);
    }

    vec3 surfaceShading(
        const MaterialInputs materialInputs,
        const ShadingData shadingData,
        const LightData lightData
    ) {
        vec2 uv = getFlippedUV();
        
        vec3 litColor = shadingData.diffuseColor;
        
        vec3 shadeColor = materialParams.shadeColor.rgb;
        if (materialParams.hasShadeTexture) {
            shadeColor *= texture(materialParams_shadeTexture, uv).rgb;
        }
        
        float dotNL = lightData.NdotL;
        float shading = dotNL + materialParams.shadingShift;
        float toony = materialParams.shadingToony;
        shading = linearstep(-1.0 + toony, 1.0 - toony, shading);
        
        float shadow = lightData.visibility * lightData.attenuation;
        shading *= shadow;
        
        vec3 lightColor = lightData.colorIntensity.rgb * lightData.colorIntensity.w;
        vec3 mixedColor = mix(shadeColor, litColor, shading);
        vec3 diffuse = lightColor * (mixedColor / PI);
        
        if (materialParams.v0CompatShade) {
            diffuse = min(diffuse, litColor);
        }
        
        vec3 viewDir = getWorldViewVector();
        vec3 normal = getWorldNormalVector();
        float NdotV = saturate(dot(viewDir, normal));
        
        float rim = pow(saturate(1.0 - NdotV + materialParams.rimLift), materialParams.rimPower);
        
        vec3 rimLightContrib = lightColor / PI;
        vec3 rimMix = mix(vec3(1.0), rimLightContrib, materialParams.rimLightingMix);
        diffuse += rimMix * materialParams.rimColor * rim;
        
        float ambientContrib = (1.0 - shadow) * materialParams.giEqualization;
        diffuse += litColor * ambientContrib * 0.1;
        
        return diffuse;
    }
}
