material {
    name : VrmMToonOpaque,
    shadingModel : lit,
    customSurfaceShading : true,
    blending : opaque,
    doubleSided : true,
    parameters : [
        { type : float4, name : baseColor },
        { type : float4, name : shadeColor },
        { type : float,  name : shadingToony },
        { type : float,  name : shadingShift },
        { type : float3, name : rimColor },
        { type : float,  name : rimPower },
        { type : float,  name : rimLift },
        { type : float,  name : rimLightingMix },
        { type : float3, name : emissiveColor },
        { type : float,  name : giEqualization },
        { type : sampler2d, name : mainTexture },
        { type : sampler2d, name : shadeTexture },
        { type : sampler2d, name : emissiveTexture },
        { type : bool, name : flipV },
        { type : bool, name : hasShadeTexture },
        { type : bool, name : hasEmissiveTexture },
        { type : bool, name : v0CompatShade }
    ],
    requires : [
        uv0
    ]
}

fragment {
    // Helper to get flipped UV
    vec2 getFlippedUV() {
        vec2 uv = getUV0();
        if (materialParams.flipV) {
            uv.y = 1.0 - uv.y;
        }
        return uv;
    }
    
    // Matching three-vrm: linearstep for sharp toon transitions
    float linearstep(float a, float b, float t) {
        return clamp((t - a) / (b - a + 0.00001), 0.0, 1.0);
    }
    
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        
        vec2 uv = getFlippedUV();
        vec4 texColor = texture(materialParams_mainTexture, uv);
        
        material.baseColor = texColor * materialParams.baseColor;
        
        // No specular highlights for toon shading
        material.roughness = 1.0;
        material.metallic = 0.0;
        
        // Emissive (set here, NOT in surfaceShading which is per-light)
        vec3 emissive = materialParams.emissiveColor;
        if (materialParams.hasEmissiveTexture) {
            emissive *= texture(materialParams_emissiveTexture, uv).rgb;
        }
        material.emissive = vec4(emissive, 0.0);
    }

    // ====================================================================
    // MToon custom surface shading — faithful port of three-vrm algorithm
    // ====================================================================
    //
    // Reference: three-vrm mtoon.frag  RE_Direct_MToon / getDiffuse / getShading
    //
    // Key differences from the previous implementation:
    //   1. Use 1/PI (BRDF_Lambert) for physically correct diffuse normalization
    //   2. Apply shadow/visibility ONLY ONCE through getShading()
    //   3. Shade color is NOT multiplied by litColor
    //   4. GI equalization contributes ambient
    //   5. VRM 0.x compat: clamp result to diffuseColor
    // ====================================================================
    
    vec3 surfaceShading(
        const MaterialInputs materialInputs,
        const ShadingData shadingData,
        const LightData lightData
    ) {
        vec2 uv = getFlippedUV();
        
        // == Lit color (diffuseColor = baseColor * texture, already set via material.baseColor) ==
        vec3 litColor = shadingData.diffuseColor;
        
        // == Shade color: shadeColorFactor * shadeTexture (NOT multiplied by litColor) ==
        // Three-vrm: material.shadeColor = shadeColorFactor * texture(shadeMultiplyTexture)
        vec3 shadeColor = materialParams.shadeColor.rgb;
        if (materialParams.hasShadeTexture) {
            shadeColor *= texture(materialParams_shadeTexture, uv).rgb;
        }
        
        // == Core MToon shading (three-vrm getShading function) ==
        float dotNL = lightData.NdotL;
        
        // shading = dotNL + shadingShift
        float shading = dotNL + materialParams.shadingShift;
        
        // linearstep with toony factor: linearstep(-1+toony, 1-toony, shading)
        float toony = materialParams.shadingToony;
        shading = linearstep(-1.0 + toony, 1.0 - toony, shading);
        
        // Apply shadow/visibility ONCE (three-vrm: shading *= shadow)
        float shadow = lightData.visibility * lightData.attenuation;
        shading *= shadow;
        
        // == getDiffuse: mix shade ↔ lit, then apply light color with BRDF_Lambert ==
        // Three-vrm: lightColor * BRDF_Lambert(mix(shadeColor, diffuseColor, shading))
        // BRDF_Lambert(c) = c / PI — this is the physically correct normalization
        // for diffuse lighting in a physically-based pipeline
        vec3 lightColor = lightData.colorIntensity.rgb * lightData.colorIntensity.w;
        vec3 mixedColor = mix(shadeColor, litColor, shading);
        vec3 diffuse = lightColor * (mixedColor / PI);
        
        // VRM 0.x compatibility: clamp to prevent overbright
        // Three-vrm: col = min(col, material.diffuseColor)
        if (materialParams.v0CompatShade) {
            diffuse = min(diffuse, litColor);
        }
        
        // == Rim lighting ==
        // Three-vrm computes rim ONCE after all lights using accumulated directSpecular.
        // In Filament's per-light model, we approximate by using the light contribution.
        vec3 viewDir = getWorldViewVector();
        vec3 normal = getWorldNormalVector();
        float NdotV = saturate(dot(viewDir, normal));
        
        float rim = pow(saturate(1.0 - NdotV + materialParams.rimLift), materialParams.rimPower);
        
        // rimMix = mix(1.0, lightContribution, rimLightingMixFactor)
        // Three-vrm uses accumulated irradiance; we use this light's color as a proxy
        vec3 rimLightContrib = lightColor / PI;
        vec3 rimMix = mix(vec3(1.0), rimLightContrib, materialParams.rimLightingMix);
        diffuse += rimMix * materialParams.rimColor * rim;
        
        // == GI equalization: blend indirect light contribution ==
        // Three-vrm: indirectDiffuse = irradiance * BRDF_Lambert(diffuseColor)
        // Then giEqualization mixes between shaded and unshaded indirect
        // In Filament's surfaceShading we can approximate ambient contribution 
        // using a scaled term based on NdotL
        float ambientContrib = (1.0 - shadow) * materialParams.giEqualization;
        diffuse += litColor * ambientContrib * 0.1;
        
        return diffuse;
    }
}
