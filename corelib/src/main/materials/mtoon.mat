material {
    name : MToon,
    shadingModel : lit,
    customSurfaceShading : true,
    blending : opaque,
    doubleSided : true,
    parameters : [
        { type : float4, name : baseColor },
        { type : float4, name : shadeColor },
        { type : float,  name : shadeToony },
        { type : float,  name : shadeShift },
        { type : float3, name : rimColor },
        { type : float,  name : rimPower },
        { type : float,  name : rimLift },
        { type : sampler2d, name : mainTexture },
        { type : sampler2d, name : shadeTexture },
        { type : bool, name : flipV }
    ],
    requires : [
        uv0
    ]
}

fragment {
    // Helper to get flipped UV
    vec2 getFlippedUV() {
        vec2 uv = getUV0();
        if (materialParams.flipV) {
            uv.y = 1.0 - uv.y;
        }
        return uv;
    }
    
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        
        // Sample main texture with flipped UV
        vec2 uv = getFlippedUV();
        vec4 texColor = texture(materialParams_mainTexture, uv);
        
        // Apply base color tint but don't multiply texture - use texture color directly
        material.baseColor = texColor;
        material.baseColor.a = 1.0; // Force opaque
    }

    vec3 surfaceShading(
        const MaterialInputs materialInputs,
        const ShadingData shadingData,
        const LightData lightData
    ) {
        // Get the texture color directly (already in linear space from baseColor)
        vec3 litColor = shadingData.diffuseColor;
        
        // Very simple toon shading - just slightly darken shadows
        float NdotL = max(lightData.NdotL, 0.0);
        
        // Toon shading step
        float halfWidth = materialParams.shadeToony * 0.5 + 0.001;
        float shadeValue = smoothstep(
            materialParams.shadeShift - halfWidth,
            materialParams.shadeShift + halfWidth,
            NdotL
        );
        
        // Simple shade - mix between slightly darker and original
        vec3 shadeColor = litColor * materialParams.shadeColor.rgb;
        vec3 finalColor = mix(shadeColor, litColor, shadeValue);
        
        // Subtle rim lighting
        vec3 viewDir = getWorldViewVector();
        vec3 normal = getWorldNormalVector();
        float rim = 1.0 - saturate(dot(viewDir, normal));
        rim = pow(rim, materialParams.rimPower);
        rim = smoothstep(materialParams.rimLift, 1.0, rim);
        finalColor += materialParams.rimColor * rim * 0.1;
        
        // IMPORTANT: Don't multiply by light intensity to avoid overbright
        // Just use a subtle light influence
        float lightInfluence = 0.3 + 0.7 * shadeValue;
        
        return finalColor * lightInfluence;
    }
}
