material {
    name : MToon,
    shadingModel : lit,
    customSurfaceShading : true,
    blending : opaque,
    doubleSided : true,
    parameters : [
        { type : float4, name : baseColor },
        { type : float4, name : shadeColor },
        { type : float,  name : shadeToony },
        { type : float,  name : shadeShift },
        { type : float3, name : rimColor },
        { type : float,  name : rimPower },
        { type : float,  name : rimLift },
        { type : sampler2d, name : mainTexture },
        { type : sampler2d, name : shadeTexture }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        
        // Sample main texture and apply base color tint
        vec4 texColor = texture(materialParams_mainTexture, getUV0());
        material.baseColor = texColor * materialParams.baseColor;
        material.baseColor.a = 1.0; // Force opaque
    }

    vec3 surfaceShading(
        const MaterialInputs materialInputs,
        const ShadingData shadingData,
        const LightData lightData
    ) {
        // Use the diffuse color from material (includes texture * baseColor)
        vec3 litColor = shadingData.diffuseColor;
        
        // MToon-style toon shading calculation
        float shadeGrade = lightData.NdotL;
        
        // Toon shading step function
        float halfWidth = materialParams.shadeToony * 0.5 + 0.001;
        float shadeValue = smoothstep(
            materialParams.shadeShift - halfWidth,
            materialParams.shadeShift + halfWidth,
            shadeGrade
        );
        
        // Sample shade texture and multiply with shade color
        vec4 shadeTex = texture(materialParams_shadeTexture, getUV0());
        vec3 shadeColorFinal = shadeTex.rgb * materialParams.shadeColor.rgb;
        
        // If shade texture is white (dummy), use darkened lit color instead
        if (shadeTex.r > 0.99 && shadeTex.g > 0.99 && shadeTex.b > 0.99) {
            shadeColorFinal = litColor * materialParams.shadeColor.rgb;
        }
        
        // Interpolate between shade and lit color
        vec3 finalColor = mix(shadeColorFinal, litColor, shadeValue);
        
        // Rim lighting (edge highlight)
        vec3 viewDir = getWorldViewVector();
        vec3 normal = getWorldNormalVector();
        float rim = 1.0 - saturate(dot(viewDir, normal));
        rim = pow(rim, materialParams.rimPower);
        rim = smoothstep(materialParams.rimLift, 1.0, rim);
        finalColor += materialParams.rimColor * rim * 0.3; // Reduce rim intensity
        
        // Apply light color and intensity
        vec3 light = lightData.colorIntensity.rgb * lightData.colorIntensity.w;
        float lightAtten = max(lightData.visibility * lightData.attenuation, 0.2); // Min 20% ambient
        
        return finalColor * light * lightAtten;
    }
}
