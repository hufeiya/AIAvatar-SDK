<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- send_haptic 智能体工具：预设震动波形（普通权限） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 视频模式：用户相机预览/人脸追踪/抓拍 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- 系统语音识别（SystemAsr.kt）：Android 11+ 包可见性过滤——不声明
         <queries> 时 RecognitionService/RECOGNIZE_SPEECH 的解析一律为空，
         isRecognitionAvailable 与自建的可用性兜底都看不到识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:largeHeap="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIAvatarSDK">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.AIAvatarSDK">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 最小接入样例（README 快速开始的活样例）；无 intent-filter，
             adb shell am start -n com.neethu.aiavatar_sdk/.SimpleDemoActivity 直达 -->
        <activity
            android:name=".SimpleDemoActivity"
            android:exported="true"
            android:label="@string/simple_demo_label" />

        <!-- 多虚拟人舞台（docs/multi-avatar-feasibility.md P0 调试/演示）；
             exported 供 adb 直达与 STAGE_CMD 广播调试通道 -->
        <activity
            android:name=".multiavatar.MultiAvatarActivity"
            android:exported="true"
            android:label="Multi-Avatar Stage" />

        <!-- 4v4 辩论赛（docs/debate-feasibility.md P0）；exported 供 adb
             DEBATE_CONTROL 协议直达，singleTop 让 onNewIntent 收新命令 -->
        <activity
            android:name=".debate.DebateActivity"
            android:exported="true"
            android:label="Debate Stage"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    </application>

</manifest>